layout autosave on
layout new big
select 1
layout new vert_split
select 1 
split -v
focus right 
select 4 
focus left
layout new t_pane
select 1
split
resize -v +7
focus down
select 3
split -v
resize -h +10
focus right
select 4
focus up
layout new tri_split
select 4
split
focus down
select 1
split
focus down
select 3
focus up
